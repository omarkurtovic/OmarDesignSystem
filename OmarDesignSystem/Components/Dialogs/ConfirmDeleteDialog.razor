@namespace OmarDesignSystem

<MudDialog>
    <DialogContent>
        <MudText>@Message</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="@_isDeleting">Cancel</MudButton>
        <LoadingButton Color="@Color.Error" 
                       Variant="@Variant.Filled" 
                       OnClick="HandleDeleteAsync" 
                       LoadingText="Deleting...">
            Delete
        </LoadingButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; }

    [Parameter] public string Message { get; set; } = "Are you sure you want to delete this item?";
    
    // Changed from Task<Result> to Task<bool>
    [Parameter] public Func<Task<bool>> OnDelete { get; set; }

    private bool _isDeleting = false;

    private async Task HandleDeleteAsync()
    {
        _isDeleting = true;
        try
        {
            // The dialog only cares about the boolean outcome
            bool isSuccess = await OnDelete();
            MudDialog.Close(DialogResult.Ok(isSuccess));
        }
        finally
        {
            _isDeleting = false;
        }
    }
    
    private void Cancel() => MudDialog.Cancel();
}